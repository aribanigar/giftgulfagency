# Public site URL — used for canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://giftsgulfagency.vercel.app

# Admin panel (/admin) password. Required to enable admin login.
ADMIN_PASSWORD=

# Settings store — add a Redis (Upstash) integration from the Vercel
# Marketplace and these are injected automatically. Without them, the
# admin panel still loads but changes won't persist, and the public site
# falls back to the defaults in src/lib/settings.ts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudinary — image hosting/CDN for site photography, used instead of
# Vercel's metered Image Optimization API. Get these from your Cloudinary
# dashboard (Account Details): https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (quote requests, customer confirmations, quotes) via Resend.
# https://resend.com: create an API key and verify your sending domain.
# Without a verified domain, Resend only delivers to the account owner.
RESEND_API_KEY=
EMAIL_FROM="Gifts Gulf Advertising <quotes@your-verified-domain.com>"
# Where new enquiries and accepted-quote alerts go (defaults to this address).
ADMIN_NOTIFY_EMAIL=arfatshah.qa@gmail.com
